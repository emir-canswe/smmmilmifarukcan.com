# Kopyalayın: .env olarak kaydedin (Git'e eklenmez).
# Render: Dashboard → Web Service → Environment → aynı anahtarları girin.

# Ortam (Render genelde otomatik production; yine de ekleyebilirsiniz)
NODE_ENV=production

# Yerel çalıştırırken (Render PORT'u kendisi verir)
# PORT=3000

# --- İletişim formu (SMTP) — üretimde zorunlu ---
# Resend (ücretsiz kotayı kontrol edin): https://resend.com
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxx   (API anahtarı)
#   MAIL_FROM=noreply@sizin-domain.com   (Resend’de doğrulanmış gönderen)
#   MAIL_TO=ilmifarukcan@gmail.com     (form mesajlarının gideceği adres)

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mesajın iletileceği gelen kutusu
MAIL_TO=ilmifarukcan@gmail.com

# Gönderen adresi (çoğu sağlayıcıda doğrulanmış domain gerekir)
MAIL_FROM=
