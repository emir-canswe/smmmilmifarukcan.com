# Sunucu (3000 meşgulse 3001 kullanın)
PORT=3001
NODE_ENV=production

# İsteğe bağlı: SMTP ayarlanırsa iletişim formu e-posta ile size iletilir.
# Boş bırakılırsa mesajlar sunucu konsoluna yazılır (geliştirme / yedek).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourdomain.com
MAIL_TO=ilmifarukcan@gmail.com
